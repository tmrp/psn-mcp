{
  "name": "psn-mcp",
  "version": "0.1.1",
  "description": "MCP server for interfacing with the PlayStation Network",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tmrp/psn-mcp.git"
  },
  "homepage": "https://github.com/tmrp/psn-mcp#readme",
  "bugs": "https://github.com/tmrp/psn-mcp/issues",
  "bin": {
    "psn-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "changeset": "changeset",
    "prepublishOnly": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "version:packages": "changeset version && pnpm install --lockfile-only && prettier --write \"**/CHANGELOG.md\"",
    "release": "changeset publish"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "playstation",
    "psn",
    "trophies"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^26.1.0",
    "prettier": "^3.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
