{
  "name": "psn-mcp",
  "version": "0.1.0",
  "description": "MCP server for interfacing with the PlayStation Network",
  "type": "module",
  "license": "MIT",
  "bin": {
    "psn-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
